{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "tonconnect-manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "icon-180.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/tonconnect-manifest.json",
      "headers": {
        "content-type": "application/json"
      },
      "dest": "/tonconnect-manifest.json"
    },
    {
      "src": "/icon-180.png",
      "dest": "/icon-180.png"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
